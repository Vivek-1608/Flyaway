<% layout("/layouts/boilerplate.ejs") -%>

<section class="hero-section">
    <div class="hero-overlay">
        <div class="hero-content">
            <h1>Find Your Perfect Stay</h1>

            <p>
                Explore unique villas, cabins, apartments, mountains,
                beaches and unforgettable destinations.
            </p>

            <a href="/listings" class="explore-btn">
                Explore Listings
            </a>
        </div>
    </div>
</section>

<section class="features-section">

    <h2 class="feature-heading">Why FlyAway?</h2>

    <div class="feature-grid">

        <div class="feature-card">
            <i class="fa-solid fa-earth-americas"></i>
            <h4>Global Destinations</h4>
            <p>Explore stays from around the world.</p>
        </div>

        <div class="feature-card">
            <i class="fa-solid fa-house"></i>
            <h4>Unique Stays</h4>
            <p>Cabins, villas, domes, farms and more.</p>
        </div>

        <div class="feature-card">
            <i class="fa-solid fa-star"></i>
            <h4>Trusted Experience</h4>
            <p>Find highly rated places to stay.</p>
        </div>

    </div>

</section>